# Configuración del backend CEFOR

# Puerto del servidor
PORT=3000

# Configuración de PostgreSQL (Railway)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cefor
DB_USER=postgres
DB_PASSWORD=postgres

# Secret para JWT
JWT_SECRET=cefor_secret_key_2024_change_in_production

# URL del frontend (para enlaces de recuperación)
FRONTEND_URL=http://localhost:5173

# Resend API Key para envío de emails
# RESEND_API_KEY=re_xxxxxxxxxxxx
# RESEND_FROM=onboarding@resend.dev
