# Configuración del backend CEFOR

# Puerto del servidor
PORT=3000

# Configuración de PostgreSQL (Railway)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cefor
DB_USER=postgres
DB_PASSWORD=postgres

# Secret para JWT
JWT_SECRET=cefor_secret_key_2024_change_in_production

# URL del frontend (para enlaces de recuperación)
FRONTEND_URL=http://localhost:5173

# Configuración SMTP para emails (Gmail)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tu-correo@gmail.com
# SMTP_PASS=tu-contraseña-de-app
